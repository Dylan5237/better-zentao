<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>{{TRIGGER_TIME}}</StartBoundary>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>{{DAY_OF_MONTH}}</Day>
        </DaysOfMonth>
        <Months>
          <January/>
          <February/>
          <March/>
          <April/>
          <May/>
          <June/>
          <July/>
          <August/>
          <September/>
          <October/>
          <November/>
          <December/>
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
  </Settings>
  <Actions>
    <Exec>
      <Command>%SystemRoot%\System32\cmd.exe</Command>
      <Arguments>{{ARGS}}</Arguments>
      <WorkingDirectory>{{WORKING_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
