{
  "name": "better-zentao",
  "version": "0.0.0",
  "description": "本地禅道协作助手",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "bzt": "dist/adapters/cli/bzt.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts test && prettier --check --end-of-line auto src scripts test eslint.config.mjs vitest.config.ts package.json tsconfig*.json config/*.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.18.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
